config OPLUS_DYNAMIC_READAHEAD
	bool "dynamic page fault read-ahead size"
	depends on OPLUS_FEATURE_SCHED_ASSIST && FG_TASK_UID
	default n
	help
	  This feature dynamically set read-ahead size for performance.
