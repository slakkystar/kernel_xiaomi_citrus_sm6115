# IR Blaster
CONFIG_IR_SPI=y
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y

# Touchscreen
CONFIG_TOUCHSCREEN_NT36672A=y
CONFIG_TOUCHSCREEN_FT8719=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
# CONFIG_TOUCHSCREEN_FTS is not set
# CONFIG_TOUCHSCREEN_NT36XXX is not set

# Kernel Behavior
CONFIG_PANIC_ON_REFCOUNT_ERROR=n

# MSM Debugging
CONFIG_MSM_RDBG=y

# NFC
# CONFIG_NFC_NQ is not set

# Platform
CONFIG_BOARD_XIAOMI=y
CONFIG_BOARD_XIAOMI_SM6115=y

# Switch
CONFIG_SWITCH=y

# WLAN
CONFIG_QCA_CLD_WLAN=y

# Xiaomi Specific Drivers
CONFIG_SIMTRAY_STATUS=y
CONFIG_DPDT_STATUS=y
CONFIG_MI_FS=y
CONFIG_HQ_SYSFS_SUPPORT=y

#CONFIG_WIREGUARD_DEBUG is not set

# NetHunter dependencies
CONFIG_NETHUNTER_SUPPORT=y
CONFIG_PCI=y
CONFIG_INPUT=y
CONFIG_FB=y
CONFIG_HID=y

# Linux Random Number Generator
CONFIG_LRNG=y

# Other
CONFIG_FRAME_WARN=0
CONFIG_HID_DRAGONRISE=y
# CONFIG_DRAGONRISE_FF is not set
CONFIG_HID_PANTHERLORD=y
CONFIG_PANTHERLORD_FF=y
CONFIG_HID_GREENASIA=y
CONFIG_GREENASIA_FF=y
CONFIG_USB_GSPCA=y
CONFIG_LCD_CLASS_DEVICE=y
CONFIG_TCP_CONG_HTCP=y
CONFIG_TCP_CONG_BIC=y
CONFIG_TCP_CONG_BBR=y
# CONFIG_RMNET_PERF is not set
# CONFIG_RMNET_SHS is not set
