# --- qcom ---
CONFIG_OPLUS_SYSTEM_KERNEL_QCOM=y

# --- sched_assist (UX), locking strategy ---
CONFIG_OPLUS_FEATURE_SCHED_ASSIST=y
CONFIG_OPLUS_FEATURE_SCHED_UX_PRIORITY=y
CONFIG_OPLUS_UX_IM_FLAG=y
CONFIG_OPLUS_CPU_AUDIO_PERF=y
CONFIG_OPLUS_FEATURE_AUDIO_OPT=y
CONFIG_OPLUS_LOCKING_STRATEGY=y
CONFIG_OPLUS_LOCKING_OSQ=y
CONFIG_OPLUS_LOCKING_MONITOR=y
CONFIG_LOCKING_PROTECT=y
CONFIG_OPLUS_FEATURE_EAS_OPT=y
CONFIG_OPLUS_FEATURE_VT_CAP=y
CONFIG_OPLUS_CPUFREQ_IOWAIT_PROTECT=y

# --- frame_boost, uad ioctl, tpd/tpp, im, game_opt, abnormal_flag, sigkill, uxio, hans ---
CONFIG_OPLUS_FEATURE_FRAME_BOOST=y
CONFIG_UA_KERNEL_CPU_IOCTL=y
CONFIG_OPLUS_FEATURE_TPD=y
CONFIG_OPLUS_FEATURE_TPP=y
CONFIG_OPLUS_FEATURE_IM=y
CONFIG_OPLUS_FEATURE_GAME_OPT=y
CONFIG_OPLUS_FEATURE_ABNORMAL_FLAG=y
CONFIG_OPLUS_FEATURE_SIGKILL_DIAGNOSIS=y
CONFIG_OPLUS_FEATURE_UXIO_FIRST=y
CONFIG_OPLUS_HANS=y
# CONFIG_OPLUS_BINDER_STRATEGY is not set

# --- healthinfo / jank / fg_uid / mem / blk monitor, iomonitor, task_cpustats, cpu_jankinfo ---
CONFIG_OPLUS_HEALTHINFO=y
CONFIG_FG_TASK_UID=y
CONFIG_OPLUS_JANK_INFO=y
CONFIG_OPLUS_MEM_MONITOR=y
CONFIG_OPLUS_BLK_MONITOR=y
CONFIG_MMAP_LOCK_OPT=y
CONFIG_IOMONITOR=y
# CONFIG_IOMONITOR_WITH_F2FS is not set
CONFIG_OPLUS_CTP=y
CONFIG_OPLUS_SCHED=y
CONFIG_OPLUS_FEATURE_CPU_JANKINFO=y
CONFIG_OPLUS_FEATURE_LOWMEM_DBG=y

# --- process_reclaim ---
CONFIG_PROCESS_RECLAIM=y
CONFIG_PROCESS_RECLAIM_ENHANCE=y

# --- zram_opt + hybridswap ---
CONFIG_OPLUS_ZRAM_OPT=y
CONFIG_HYBRIDSWAP=y
CONFIG_HYBRIDSWAP_SWAPD=y
CONFIG_HYBRIDSWAP_CORE=y
CONFIG_HYBRIDSWAP_ASYNC_COMPRESS=y
# CONFIG_ZRAM_DEDUP is not set
# CONFIG_ZRAM_WRITEBACK is not set
# CONFIG_ZWB_HANDLE is not set

# --- MGLRU disabled ---
# CONFIG_LRU_GEN is not set

# --- other memory ---
CONFIG_BALANCE_ANON_FILE_RECLAIM=y
CONFIG_OPLUS_UXMEM_OPT=y
CONFIG_OPLUS_DYNAMIC_READAHEAD=y
CONFIG_KSHRINK_SLABD=y
CONFIG_SHRINK_LRU_TRYLOCK=y
CONFIG_LOOK_AROUND=y
CONFIG_MAPPED_PROTECT=y
CONFIG_OOM_REAPER_RECLAIM_MEMORY=y
CONFIG_DYNAMIC_TUNNING_SWAPPINESS=y
CONFIG_PROACTIVE_COMPACT=y
CONFIG_PHYSICAL_ANTI_FRAGMENTATION=y
CONFIG_OPLUS_MULTI_KSWAPD=y
CONFIG_KSWAPD_UNBIND_MAX_CPU=y
CONFIG_OPLUS_MEMORY_ISOLATE=y
CONFIG_VIRTUAL_RESERVE_MEMORY=y
CONFIG_OPLUS_ION_BOOSTPOOL=y
CONFIG_PAGE_IDLE_FLAG=y
CONFIG_DAMON=y
CONFIG_DAMON_PADDR=y
CONFIG_DAMON_RECLAIM=y

# --- memleak ---
CONFIG_VMALLOC_DEBUG=y
CONFIG_DUMP_TASKS_MEM=y
CONFIG_SVELTE=y
# CONFIG_KMALLOC_DEBUG is not set

# --- net ---
CONFIG_OPLUS_FEATURE_DATA_EVAL=y
CONFIG_OPLUS_FEATURE_DATA_MODULE=y
CONFIG_OPLUS_FEATURE_DNS_HOOK=y
CONFIG_OPLUS_FEATURE_STATS_CALC=y
CONFIG_OPLUS_FEATURE_QR_SCAN=y
