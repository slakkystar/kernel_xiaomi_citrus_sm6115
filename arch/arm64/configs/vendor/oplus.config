# OPLUS_FEATURE_ZRAM_OPT
CONFIG_DYNAMIC_TUNNING_SWAPPINESS=y
CONFIG_OPLUS_ZRAM_OPT=y
CONFIG_PGTABLE_MAPPING=y

# OPLUS_FEATURE_HYBRIDSWAP
CONFIG_HYBRIDSWAP=y
CONFIG_HYBRIDSWAP_SWAPD=y
CONFIG_HYBRIDSWAP_CORE=y
# CONFIG_ZRAM_DEDUP is not set

# OPLUS_FEATURE_SCHED_ASSIST
CONFIG_OPLUS_FEATURE_SCHED_ASSIST=y
# CONFIG_OPLUS_FEATURE_SCHED_SPREAD is not set
CONFIG_OPLUS_UX_IM_FLAG=y
# CONFIG_OPLUS_CPU_AUDIO_PERF is not set
CONFIG_LOCKING_PROTECT=y
# CONFIG_MMAP_LOCK_OPT is not set
CONFIG_OPLUS_FEATURE_UXIO_FIRST=y
CONFIG_OPLUS_SF_BOOST=y

# OPLUS_FEATURE_HEALTHINFO
CONFIG_OPLUS_HEALTHINFO=y
CONFIG_OPLUS_JANK_INFO=y
CONFIG_FG_TASK_UID=y
CONFIG_OPLUS_MEM_MONITOR=y
CONFIG_OPLUS_BLK_MONITOR=y

# OPLUS_FEATURE_IOMONITOR
CONFIG_IOMONITOR=y
# CONFIG_IOMONITOR_WITH_F2FS is not set

# OPLUS_FEATURE_TASK_CPUSTATS
CONFIG_OPLUS_CTP=y

# OPLUS_FEATURE_PROCESS_RECLAIM
CONFIG_PROCESS_RECLAIM_ENHANCE=y
CONFIG_KSHRINK_SLABD=y

CONFIG_OPLUS_UXMEM_OPT=y
CONFIG_OPLUS_DYNAMIC_READAHEAD=y

# OPLUS_FEATURE_PERFORMANCE
CONFIG_DMABUF_PROC_INTERFACE=y

# OPLUS_FEATURE_PROACTIVE_COMPACT
CONFIG_PROACTIVE_COMPACT=y

# OPLUS_FEATURE_HANS_FREEZE
CONFIG_OPLUS_FEATURE_HANS=y

CONFIG_OPLUS_FEATURE_GAME_OPT=y
CONFIG_MAPPED_PROTECT=y
CONFIG_OOM_REAPER_RECLAIM_MEMORY=y
CONFIG_LOOK_AROUND=y
CONFIG_SHRINK_LRU_TRYLOCK=y
